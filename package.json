{
  "name": "saga-studio-desktop",
  "productName": "Saga Studio",
  "version": "0.1.0",
  "description": "Saga Studio as a standalone desktop app — a local audiobook editor",
  "main": "main.js",
  "license": "MIT",
  "author": "Caitlyn Meeks",
  "private": true,
  "scripts": {
    "start": "electron .",
    "runtime": "bash scripts/prepare-runtime.sh",
    "stamp": "bash scripts/stamp-version.sh",
    "dist": "npm run --silent stamp && electron-builder"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "wtf.caity.sagastudio",
    "productName": "Saga Studio",
    "asar": false,
    "files": [
      "main.js",
      "preload.js",
      "shell.html",
      "lib/**/*",
      "python/studio.py",
      "python/studio_ui.html",
      "python/stage_ui.html",
      "python/player.js",
      "python/desk.js",
      "python/export_player.html",
      "python/omnivoice_server.py",
      "python/chatterbox_server.py",
      "python/saga_mcp.py",
      "python/openai_agent.py",
      "python/discuss_rules.md",
      "python/requirements.txt",
      "python/version.json"
    ],
    "extraResources": [
      {
        "from": "build/runtime/python",
        "to": "python"
      },
      {
        "from": "build/runtime/uv",
        "to": "uv"
      },
      {
        "from": "build/models",
        "to": "models"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ],
      "icon": "build/icon.icns",
      "identity": "-"
    },
    "directories": {
      "output": "dist"
    }
  }
}
